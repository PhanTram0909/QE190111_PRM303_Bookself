rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Khóa chống trùng: sha256 của "title|author" đã trim + lowercase
    function bookKey(d) {
      return hashing.sha256(
        (d.title.trim().lower() + '|' + d.author.trim().lower()).toUtf8()
      ).toHexString();
    }

    // docId bắt buộc = userId + '_' + bookKey => mỗi user không thể lưu trùng title+author
    function validDocId(docId, d) {
      return docId == d.userId + '_' + bookKey(d);
    }

    function validBook(d, docId) {
      return d.keys().hasAll(['userId', 'title', 'author', 'genre', 'status', 'favorite', 'createdAt'])
        // title
        && d.title is string
        && d.title.trim().size() > 0
        && d.title.size() <= 100
        // author
        && d.author is string
        && d.author.trim().size() > 0
        && d.author.size() <= 60
        // genre, status
        && d.genre in ['Fiction', 'Non-Fiction', 'Academic', 'Other']
        && d.status in ['To Read', 'Reading', 'Finished']
        // rating (tùy chọn): số nguyên 0..5
        && (!('rating' in d) || d.rating == null
            || (d.rating is int && d.rating >= 0 && d.rating <= 5))
        // favorite
        && d.favorite is bool
        // notes (tùy chọn): tối đa 300 ký tự
        && (!('notes' in d) || d.notes == null
            || (d.notes is string && d.notes.size() <= 300))
        // createdAt
        && d.createdAt is timestamp
        // nếu có lưu field id thì phải bằng document id
        && (!('id' in d) || d.id == docId)
        // chống trùng title+author (không phân biệt hoa thường)
        && validDocId(docId, d);
    }

    match /books/{bookId} {
      // Đọc sách: cho phép get (cả khi doc chưa tồn tại) và query danh sách của mình
      allow get: if request.auth != null
                 && (resource == null || resource.data.userId == request.auth.uid);

      allow list: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Tạo: userId phải là người đang đăng nhập + dữ liệu hợp lệ
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && validBook(request.resource.data, bookId);

      // Sửa: sách của mình, không đổi chủ, không đổi createdAt, vẫn hợp lệ
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && validBook(request.resource.data, bookId);

      // Xóa: chỉ sách của mình
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Mọi đường dẫn khác: từ chối
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
